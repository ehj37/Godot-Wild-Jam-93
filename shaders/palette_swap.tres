[gd_resource type="VisualShader" format=3 uid="uid://d1shovxqww0y1"]

[sub_resource type="VisualShaderNodeInput" id="VisualShaderNodeInput_y2mar"]
input_name = "texture"

[sub_resource type="VisualShaderNodeTexture2DParameter" id="VisualShaderNodeTexture2DParameter_02dhm"]
parameter_name = "original_palette"

[sub_resource type="VisualShaderNodeTexture2DParameter" id="VisualShaderNodeTexture2DParameter_6oppv"]
parameter_name = "new_palette"

[sub_resource type="VisualShaderNodeIntParameter" id="VisualShaderNodeIntParameter_hjji2"]
parameter_name = "colors_count"

[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_j374f"]
size = Vector2(720, 660)
expression = "vec2 new_uv = vec2(0, 0);

for (int i = 0; i < colors_count; i ++) {
	float u = (float(i) + 0.5) / float(colors_count);
	float v = 0.5;
	vec2 uv = vec2(u, v);
	vec4 original_palette_color = texture(original_palette, uv);
	float dist = distance(color, original_palette_color);
	if (dist == 0.0) {
		new_uv = uv;
		break;
	}
}

if (is_enabled) {
	new_color = texture(new_palette, new_uv);
} else {
	new_color = texture(original_palette, new_uv);
}"

